rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /t/{code}/{col}/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (col == 'stops' || col == 'meta' || col == 'tokens' || col == 'acks');
      // 照片只能新增，不能改或刪：每人每個景點只能拍一張
      allow create: if request.auth != null && col == 'photos' && request.resource.data.keys().hasAll(['uid', 'key']);
      allow create: if request.auth != null && col == 'photoData' && request.resource.data.img.size() < 700000;
    }
  }
}
